{
  "name": "e2e-console",
  "version": "0.1.0",
  "private": true,
  "description": "Local E2E test console for mobile apps: YAML scenarios, runs through adb, Maestro or a browser, screenshots per step, backend checks, performance measurements",
  "license": "MIT",
  "author": "Samuel Berrington",
  "scripts": {
    "start": "node server.js",
    "test": "node test/run.js",
    "test:unit": "node test/run.js unit",
    "test:integration": "node test/run.js integration"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@perf-profiler/profiler": "0.10.11",
    "@perf-profiler/reporter": "0.9.0",
    "pixelmatch": "^5.3.0",
    "playwright-core": "^1.65.0",
    "pngjs": "^7.0.0",
    "yaml": "^2.8.4"
  }
}
