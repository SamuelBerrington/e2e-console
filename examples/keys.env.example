# Ключи и настройки консоли. Скопируй в keys.env, заполни и импортируй (кнопка «Импорт»).
# Известные имена идут в настройки, остальные становятся переменными {{ИМЯ}}. Пустые строки ничего не стирают.
APP_NAME=My App · E2E
APP_PACKAGE=com.example.app
APP_ACTIVITY=com.example.app.MainActivity
BUNDLE_ID=com.example.app
AVD=Pixel_8_API_35
API_BASE=https://api.example.com
ENV_NAME=staging
API_TOKEN=
SELLER_TOKEN=
# плагин входа: JS-модуль с freshToken() — см. examples/auth-plugin.js
AUTH_PLUGIN=
# роли: <ROLE>_PHONE, <ROLE>_TOKEN, <ROLE>_REFRESH_TOKEN, <ROLE>_OTP → accounts.<role>
BUYER_PHONE=
BUYER_OTP=
SELLER_PHONE=
COURIER_TOKEN=
APP_NET_TAG=
FIGMA_TOKEN=
ENGINE=adb
# MAESTRO_PATH=C:\Users\me\.maestro\maestro\bin\maestro.bat
# MAESTRO_JAVA_HOME=C:\Users\me\.gradle\jdks\...
