{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://e2e-console/scenario.schema.json",
  "title": "e2e-console scenario",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "engine": {
      "enum": [
        "adb",
        "maestro",
        "web"
      ],
      "description": "adb / maestro drive the phone, web drives a browser page (Playwright)"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tab": {
      "type": "string",
      "description": "the tab on the scenario list this scenario belongs to (name or id)"
    },
    "vars": {
      "type": "object"
    },
    "matrix": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": {
            "type": "array"
          }
        },
        {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      ]
    },
    "blocks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "params": {
            "oneOf": [
              {
                "type": "array"
              },
              {
                "type": "object"
              }
            ]
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/step"
            }
          }
        },
        "required": [
          "steps"
        ],
        "additionalProperties": false
      }
    },
    "rules": {
      "type": "object",
      "properties": {
        "noServerErrors": {
          "type": "boolean"
        },
        "allowStatus": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "additionalProperties": false
    },
    "measure": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "properties": {
            "iterations": {
              "type": "number"
            },
            "flashlight": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "performance measurement: frames, CPU, memory on every step; iterations — how many runs to queue"
    },
    "section": {
      "type": "string",
      "description": "section in the performance history (Feed, Catalog, Purchase…)"
    },
    "variants": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "vars": {
            "type": "object"
          },
          "setup": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/step"
            }
          },
          "teardown": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/step"
            }
          }
        },
        "additionalProperties": false
      },
      "description": "variants of one scenario for app modes: one run per variant, its setup before the scenario, teardown after"
    },
    "setup": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/step"
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/step"
      }
    },
    "teardown": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/step"
      }
    }
  },
  "required": [
    "steps"
  ],
  "definitions": {
    "step": {
      "oneOf": [
        {
          "type": "string",
          "description": "a step without fields: launch, back"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "launch",
                "browser",
                "phone",
                "link",
                "tap",
                "type",
                "swipe",
                "pinch",
                "back",
                "wait",
                "assertText",
                "assertScreen",
                "api",
                "ai",
                "maestro",
                "use",
                "if",
                "repeat"
              ],
              "description": "step type (the short form is the key: `- tap: Catalog`)"
            },
            "title": {
              "type": "string"
            },
            "screenshot": {
              "type": "boolean"
            },
            "figma": {
              "type": "string"
            },
            "when": {
              "$ref": "#/definitions/condition"
            },
            "on": {
              "enum": [
                "web",
                "browser",
                "phone"
              ],
              "description": "where it runs: web (the browser) or phone; default — the scenario engine"
            },
            "retry": {
              "type": "number",
              "description": "retry the step this many times on failure"
            },
            "optional": {
              "type": "boolean",
              "description": "a failure does not fail the run"
            },
            "flaky": {
              "type": "boolean",
              "description": "known flaky: two attempts, marked in the report"
            },
            "timeout": {
              "type": "number",
              "description": "seconds to wait"
            },
            "allowStatus": {
              "type": "array"
            },
            "clear": {
              "type": "boolean"
            },
            "settle": {
              "type": "number"
            },
            "url": {
              "type": "string",
              "description": "browser: the page to open (full, or a path under the site address from the settings)"
            },
            "storage": {
              "type": "object",
              "description": "browser: localStorage entries to put in place before the page loads"
            },
            "steps": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/step"
              },
              "description": "these steps run in the browser"
            },
            "target": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "properties": {
                    "android": {
                      "type": "string"
                    },
                    "ios": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              ]
            },
            "by": {
              "enum": [
                "text",
                "id"
              ]
            },
            "double": {
              "type": "boolean"
            },
            "dx": {
              "type": "number"
            },
            "dy": {
              "type": "number"
            },
            "after": {
              "type": "number"
            },
            "fallback": {
              "type": "array"
            },
            "text": {
              "type": "string"
            },
            "enter": {
              "type": "boolean"
            },
            "direction": {
              "enum": [
                "up",
                "down",
                "left",
                "right"
              ]
            },
            "fast": {
              "type": "boolean",
              "description": "a fling: 80 ms over most of the screen"
            },
            "times": {
              "type": "number",
              "description": "how many swipes in a row"
            },
            "pause": {
              "type": "number",
              "description": "seconds between swipes (0.25 with fast, else 1)"
            },
            "duration": {
              "type": "number",
              "description": "gesture duration, ms"
            },
            "seconds": {
              "type": "number"
            },
            "id": {
              "type": "string"
            },
            "absent": {
              "type": "boolean"
            },
            "regex": {
              "type": "boolean"
            },
            "count": {
              "type": "number"
            },
            "baseline": {
              "type": "string"
            },
            "threshold": {
              "type": "number"
            },
            "ignore": {
              "type": "array"
            },
            "method": {
              "enum": [
                "GET",
                "POST",
                "PUT",
                "PATCH",
                "DELETE"
              ]
            },
            "auth": {
              "type": "string"
            },
            "headers": {
              "type": "object"
            },
            "body": {},
            "expectPath": {
              "type": "string"
            },
            "expectValue": {},
            "expectStatus": {
              "type": "number"
            },
            "save": {
              "type": "object"
            },
            "poll": {
              "type": "number"
            },
            "interval": {
              "type": "number"
            },
            "commands": {
              "type": "array"
            },
            "yaml": {
              "type": "string"
            },
            "files": {
              "type": "object"
            },
            "use": {
              "type": "string"
            },
            "with": {
              "type": "object"
            },
            "if": {
              "$ref": "#/definitions/condition"
            },
            "then": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/step"
              }
            },
            "else": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/step"
              }
            },
            "until": {
              "$ref": "#/definitions/condition"
            },
            "max": {
              "type": "number"
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/step"
      }
    },
    "condition": {
      "type": "object",
      "description": "condition: visible / notVisible (text on screen), var + equals|matches, platform, not; on — which screen to look at",
      "properties": {
        "visible": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "android": {
                  "type": "string"
                },
                "ios": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "notVisible": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "android": {
                  "type": "string"
                },
                "ios": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "var": {
          "type": "string"
        },
        "equals": {},
        "matches": {
          "type": "string"
        },
        "platform": {
          "enum": [
            "android",
            "ios"
          ]
        },
        "not": {
          "$ref": "#/definitions/condition"
        },
        "on": {
          "enum": [
            "web",
            "browser",
            "phone"
          ],
          "description": "where it runs: web (the browser) or phone; default — the scenario engine"
        },
        "timeout": {
          "type": "number",
          "description": "seconds to look for visible / notVisible (3)"
        }
      },
      "additionalProperties": false
    },
    "shorthand": {
      "type": "object",
      "properties": {
        "launch": {},
        "browser": {},
        "phone": {},
        "link": {},
        "tap": {},
        "input": {},
        "swipe": {},
        "pinch": {},
        "back": {},
        "wait": {},
        "assertText": {},
        "assertScreen": {},
        "api": {},
        "ai": {},
        "maestro": {},
        "use": {},
        "if": {},
        "repeat": {}
      }
    }
  }
}
